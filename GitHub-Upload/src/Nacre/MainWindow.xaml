<Window x:Class="Nacre.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nacre.Views" Title="Nacre" Width="1280" Height="850" MinWidth="1040" MinHeight="660" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource Visible}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,24,16,20">
          <StackPanel DockPanel.Dock="Top" Margin="12,0,0,35"><TextBlock Text="Nacre" FontWeight="SemiBold" FontSize="28"/><TextBlock Text="你的本地开发收藏" Style="{StaticResource Muted}" FontSize="12" Margin="1,5,0,0"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom"><Button Content="锁定保险库" Command="{Binding LockCommand}" Margin="0,0,0,14" AutomationProperties.AutomationId="Lock"/><TextBlock Text="完全离线 · 仅本地存储" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
          <StackPanel>
            <Button Content="◇    密钥库" Command="{Binding NavigateCommand}" CommandParameter="Credentials" AutomationProperties.AutomationId="NavCredentials"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Credentials"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="≡    文本收藏" Command="{Binding NavigateCommand}" CommandParameter="Texts" AutomationProperties.AutomationId="NavTexts"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Texts"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="⚙    设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" AutomationProperties.AutomationId="NavSettings"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Settings"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="26,24,26,18" IsEnabled="{Binding IsInteractive}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsRecordsPage, Converter={StaticResource Visible}}">
            <Button Content="分类与标签" Command="{Binding TaxonomyCommand}"/>
            <Button Content="导入 .env" Command="{Binding ImportEnvCommand}" Visibility="{Binding IsTextPage, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
            <Button Content="导入文本" Command="{Binding ImportTextCommand}" Visibility="{Binding IsTextPage, Converter={StaticResource Visible}}"/>
            <Button Content="＋ 新增" Style="{StaticResource Primary}" Command="{Binding NewCommand}" Margin="0" AutomationProperties.AutomationId="New"/>
          </StackPanel>
          <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1" Visibility="{Binding IsRecordsPage, Converter={StaticResource Visible}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="290" MinWidth="255"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="440"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                <TextBlock Text="搜索名称、标签、备注或文本" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Search"/>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding CategoryFilters}" DisplayMemberPath="Label" SelectedItem="{Binding CategoryFilter}" ToolTip="分类筛选"/><ComboBox Grid.Column="2" ItemsSource="{Binding TagFilters}" DisplayMemberPath="Label" SelectedItem="{Binding TagFilter}" ToolTip="标签筛选"/></Grid>
                <ComboBox ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" Margin="0,8,0,0" Visibility="{Binding IsTextPage, Converter={StaticResource Visible}}"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox Content="仅收藏" IsChecked="{Binding OnlyFavorites}"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSorts}" SelectedItem="{Binding Sort}" ToolTip="排序"/></Grid>
                <TextBlock Text="{Binding ListStatus}" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,3"/>
              </StackPanel>
              <Grid><ListBox ItemsSource="{Binding VisibleRecords}" SelectedItem="{Binding SelectedRecord}" AutomationProperties.AutomationId="Records" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="★" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Favorite, Converter={StaticResource Visible}}" Margin="6,0,0,0"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Category}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedAt, Converter={StaticResource LocalTime}}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <TextBlock Text="列表中不会展示完整敏感凭据" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasRecords, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
              </Grid>
            </DockPanel>
          </Border>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
          <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasEditor, Converter={StaticResource Visible}, ConverterParameter=Invert}"><TextBlock Text="留一处，随时取用" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="选择一条记录，或创建新的收藏。" Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
              <views:RecordEditorView Visibility="{Binding HasEditor, Converter={StaticResource Visible}}"/>
            </Grid>
          </Border>
        </Grid>
        <views:SettingsView Grid.Row="1"><views:SettingsView.Style><Style TargetType="views:SettingsView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:SettingsView.Style></views:SettingsView>
      </Grid>
    </Grid>
    <views:UnlockView Visibility="{Binding IsUnlocked, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,8" Background="{DynamicResource SurfaceBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <ProgressBar Grid.Column="1" Width="90" Height="3" Margin="16,0,0,0" IsIndeterminate="True" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
        <TextBlock Grid.Column="2" Text="Phenol93" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="24,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
