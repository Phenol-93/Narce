<Window x:Class="Nacre.Views.ConfigDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="复制配置片段" Width="620" Height="520" MinWidth="500" MinHeight="400" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="选择输出字段" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="明确点击“复制明文配置”后才会生成明文。可调整输出变量名；不会写入文件。" Style="{StaticResource Muted}" Margin="0,10,0,14"/><ComboBox x:Name="Format" SelectedIndex="0" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12"><ComboBoxItem Content=".env"/><ComboBoxItem Content="JSON"/></ComboBox></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" IsCancel="True"/><Button Content="复制明文配置" Style="{StaticResource Primary}" Click="CopyClick" Margin="0"/></StackPanel>
    <ListBox x:Name="RowsList"><ListBox.ItemTemplate><DataTemplate><StackPanel><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="输出字段名"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel>
</Window>
