<UserControl x:Class="Nacre.Views.SecretFieldControl" x:Name="Control" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="ControlLoaded" Unloaded="ControlUnloaded">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <PasswordBox x:Name="Masked" PasswordChanged="MaskedChanged" AutomationProperties.AutomationId="MaskedValue"/>
    <TextBox x:Name="Revealed" Text="{Binding Value, ElementName=Control, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="PlainValue"/>
    <Button x:Name="Reveal" Grid.Column="1" Content="显示" Click="RevealClick" Margin="6,0,0,0" Padding="8,5" FontSize="11" ToolTip="临时显示 15 秒；离开窗口立即隐藏"/>
  </Grid>
</UserControl>
