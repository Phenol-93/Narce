<Window x:Class="Nacre.Views.EnvImportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nacre.Views" Title=".env 导入预览" Width="740" Height="620" MinWidth="580" MinHeight="430" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="选择要导入的环境变量" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="每项创建一条新记录，绝不自动覆盖。内容默认隐藏，可临时查看。" Style="{StaticResource Muted}" Margin="0,10,0,12"/><TextBlock x:Name="Summary" Style="{StaticResource Muted}" Margin="0,0,0,10"/><TextBox x:Name="Issues" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/></StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" IsCancel="True"/><Button Content="确认导入所选项" Style="{StaticResource Primary}" Click="ImportClick" Margin="0"/></StackPanel><CheckBox x:Name="SelectAll" Content="全选" IsChecked="True" Click="SelectAllClick"/></DockPanel>
    <ListBox x:Name="RowsList"><ListBox.ItemTemplate><DataTemplate><StackPanel><CheckBox Content="{Binding Description}" IsChecked="{Binding Selected}"/><views:SecretFieldControl Value="{Binding Value, Mode=TwoWay}" Sensitive="True"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel>
</Window>
