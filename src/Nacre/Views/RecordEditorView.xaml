<UserControl x:Class="Nacre.Views.RecordEditorView" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nacre.Views">
  <DockPanel Margin="22,20">
    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <WrapPanel><Button Content="保存" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="Save"/><Button Content="复制记录" Command="{Binding DuplicateCommand}"/></WrapPanel>
      <Button Grid.Column="1" Content="删除" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}" Margin="0" AutomationProperties.AutomationId="Delete"/>
    </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel DataContext="{Binding Editor}" Margin="0,0,10,8">
        <DockPanel><CheckBox DockPanel.Dock="Right" Content="收藏" IsChecked="{Binding Record.Favorite}" Margin="12,0,0,0"/><TextBlock Text="记录详情" FontSize="18" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="所有修改需点击保存；自动锁定会放弃未保存内容。" Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
        <TextBlock Text="名称 / 标题 *" Style="{StaticResource Label}"/><TextBox Text="{Binding Record.Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.AutomationId="RecordTitle"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="自定义分类" Style="{StaticResource Label}"/><ComboBox IsEditable="True" ItemsSource="{Binding DataContext.Categories, ElementName=Root}" Text="{Binding Record.Category, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="标签（逗号分隔）" Style="{StaticResource Label}"/><TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="多个标签用逗号分隔，可在分类与标签中统一管理"/></StackPanel>
        </Grid>
        <StackPanel Visibility="{Binding IsCredential, Converter={StaticResource Visible}}">
          <DockPanel Margin="0,23,0,10"><Button DockPanel.Dock="Right" Content="＋ 字段" Command="{Binding DataContext.AddFieldCommand, ElementName=Root}" FontSize="12" Padding="10,5" Margin="0"/><TextBlock Text="凭据字段" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <ItemsControl ItemsSource="{Binding Credential.Fields}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border CornerRadius="7" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="自定义字段名称" AutomationProperties.AutomationId="FieldName"/><Button Grid.Column="1" Content="移除" Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Danger}" Margin="8,0,0,0" FontSize="11" Padding="8,5"/></Grid>
                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><views:SecretFieldControl Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Sensitive="{Binding IsSensitive}" AutomationProperties.AutomationId="FieldValue"/><Button Grid.Column="1" Content="复制" Command="{Binding DataContext.CopyFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" Padding="10,6" AutomationProperties.AutomationId="CopyField"/></Grid>
                <CheckBox Content="敏感字段（默认隐藏，临时显示 15 秒）" IsChecked="{Binding IsSensitive}" FontSize="11" Margin="0,10,0,3"/>
                <TextBlock Text="此字段的输出环境变量名（可选）" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,5"/><TextBox Text="{Binding EnvironmentVariable, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
              </StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Button Content="选择字段并复制 .env / JSON…" Command="{Binding DataContext.CopyConfigCommand, ElementName=Root}" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,0"/>
          <TextBlock Text="Base URL" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Credential.BaseUrl, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="复制" Command="{Binding DataContext.CopyBaseUrlCommand, ElementName=Root}" Margin="8,0,0,0"/></Grid>
          <TextBlock Text="主环境变量名（用于第一个字段）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Credential.EnvironmentVariable, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="复制" Command="{Binding DataContext.CopyEnvNameCommand, ElementName=Root}" Margin="8,0,0,0"/></Grid>
          <TextBlock Text="文档 / 开发后台链接（每行一个 http / https 地址）" Style="{StaticResource Label}"/><TextBox Text="{Binding LinksText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto"/>
          <ItemsControl ItemsSource="{Binding Credential.Links}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="11" MaxWidth="450" ToolTip="在默认浏览器中打开已保存的链接"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="保存后可点击上方链接，在系统默认浏览器中打开。" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
          <TextBlock Text="使用项目 / 软件" Style="{StaticResource Label}"/><TextBox Text="{Binding Credential.Usage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="有效期（可留空；可清空日期文本取消有效期）" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding Credential.ExpiresOn}" DateValidationError="InvalidDate" SelectedDateFormat="Short" HorizontalAlignment="Left" Width="220"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsCredential, Converter={StaticResource Visible}, ConverterParameter=Invert}">
          <TextBlock Text="内容类型" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding DataContext.TextKinds, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Text.Kind}"/>
          <DockPanel Margin="0,18,0,6"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="复制正文" Command="{Binding DataContext.CopyBodyCommand, ElementName=Root}" FontSize="12"/><Button Content="导出文本" Command="{Binding DataContext.ExportTextCommand, ElementName=Root}" FontSize="12" Margin="0"/></StackPanel><TextBlock Text="正文" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
          <TextBox Text="{Binding Text.Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" MinHeight="270" MaxHeight="600" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.AutomationId="TextBody"/>
        </StackPanel>
        <TextBlock Text="备注" Style="{StaticResource Label}"/><TextBox Text="{Binding Record.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" MaxHeight="240" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{Binding TimeDescription}" Style="{StaticResource Muted}" FontSize="10" Margin="0,16,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
