<UserControl x:Class="Nacre.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,15,20">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="24" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="外观与安全" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="主题" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Theme}" Width="280" HorizontalAlignment="Left" AutomationProperties.AutomationId="Theme"/>
      <TextBlock Text="闲置自动锁定" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding AutoLocks}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.AutoLockMinutes}" Width="280" HorizontalAlignment="Left"/>
      <TextBlock Text="自动锁定时放弃未保存编辑。请随时保存。" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      <TextBlock Text="敏感剪贴板清理延时" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ClipboardTimes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.ClipboardSeconds}" Width="280" HorizontalAlignment="Left"/>
      <TextBlock Text="仅当剪贴板仍是本程序复制的内容时清理；锁定时也会尝试清理。其他应用、剪贴板管理器和托管内存不受本程序完全控制。" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,18"/>
      <Button Content="保存设置" Style="{StaticResource Primary}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveSettings"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="24" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="主密码与加密备份" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="备份始终加密。恢复前验证备份密码，并保留当前文件。修改主密码后，旧备份仍使用旧密码。" Style="{StaticResource Muted}" Margin="0,10,0,18"/>
      <WrapPanel><Button Content="修改主密码" Command="{Binding ChangePasswordCommand}"/><Button Content="保存加密备份" Command="{Binding BackupCommand}"/><Button Content="从备份恢复" Command="{Binding RestoreCommand}"/></WrapPanel>
    </StackPanel></Border>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="24"><StackPanel>
      <TextBlock Text="存储与关于" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding StorageDescription}" TextWrapping="Wrap" Margin="0,14,0,10" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
      <TextBlock Text="升级时保留原数据目录。便携模式由 EXE 旁的 portable.flag 决定，数据存放在 Data 文件夹；目录不可写时不会自动切换位置。" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/>
      <TextBlock Text="{Binding Version}" FontWeight="SemiBold"/>
      <TextBlock Text="MIT License · GitHub 项目地址尚未设置" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
      <Button Content="查看开源许可证" Command="{Binding LicenseCommand}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
