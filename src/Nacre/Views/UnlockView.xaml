<UserControl x:Class="Nacre.Views.UnlockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="36">
    <Border Width="470" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="36">
      <StackPanel IsEnabled="{Binding IsInteractive}">
        <TextBlock Text="Nacre" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Text="本地密钥与文本收藏" Style="{StaticResource Muted}" Margin="0,6,0,30"/>
        <TextBlock Text="{Binding UnlockTitle}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding UnlockDescription}" Style="{StaticResource Muted}" Margin="0,10,0,14"/>
        <TextBlock Text="主密码" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="Password" KeyDown="PasswordKeyDown" AutomationProperties.AutomationId="MasterPassword" MaxLength="1024"/>
        <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource Visible}}">
          <TextBlock Text="再次输入主密码（至少 6 个字符）" Style="{StaticResource Label}"/>
          <PasswordBox x:Name="Confirmation" KeyDown="PasswordKeyDown" AutomationProperties.AutomationId="ConfirmPassword" MaxLength="1024"/>
          <Border Background="{DynamicResource AccentSoftBrush}" Padding="12" CornerRadius="6" Margin="0,18,0,8"><TextBlock Text="主密码无法找回。忘记密码将无法恢复密钥、文本和备份。请选择独有的长密码，并妥善保管。" TextWrapping="Wrap" FontSize="12"/></Border>
          <CheckBox x:Name="Acknowledged" Content="我已了解：忘记主密码无法恢复数据" FontSize="12" AutomationProperties.AutomationId="Acknowledge"/>
        </StackPanel>
        <TextBlock x:Name="Validation" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button Content="解锁 / 创建保险库" Style="{StaticResource Primary}" Click="UnlockClick" Margin="0,16,0,10" AutomationProperties.AutomationId="Unlock"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="从加密备份恢复" Command="{Binding RestoreCommand}" FontSize="12"/><Button Content="重试目录访问" Command="{Binding RetryCommand}" FontSize="12" Margin="0"/></StackPanel>
        <TextBlock Text="{Binding StorageDescription}" Style="{StaticResource Muted}" FontSize="11" Margin="0,22,0,0"/>
      </StackPanel>
    </Border>
  </Grid></ScrollViewer>
</UserControl>
